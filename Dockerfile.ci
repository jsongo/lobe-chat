## Set global build ENV
ARG NODEJS_VERSION="24"

## Base image with required binaries and libraries
FROM node:${NODEJS_VERSION}-slim AS base

ARG USE_CN_MIRROR

ENV DEBIAN_FRONTEND="noninteractive"

# Install required system packages
RUN <<EOF
set -e
if [ "${USE_CN_MIRROR:-false}" = "true" ]; then
    sed -i "s/deb.debian.org/mirrors.ustc.edu.cn/g" "/etc/apt/sources.list.d/debian.sources"
fi
apt update
apt install ca-certificates proxychains-ng -qy
mkdir -p /distroless/bin /distroless/etc /distroless/etc/ssl/certs /distroless/lib
cp /usr/lib/$(arch)-linux-gnu/libproxychains.so.4 /distroless/lib/libproxychains.so.4
cp /usr/lib/$(arch)-linux-gnu/libdl.so.2 /distroless/lib/libdl.so.2
cp /usr/bin/proxychains4 /distroless/bin/proxychains
cp /etc/proxychains4.conf /distroless/etc/proxychains4.conf
cp /usr/lib/$(arch)-linux-gnu/libstdc++.so.6 /distroless/lib/libstdc++.so.6
cp /usr/lib/$(arch)-linux-gnu/libgcc_s.so.1 /distroless/lib/libgcc_s.so.1
cp /usr/local/bin/node /distroless/bin/node
cp /etc/ssl/certs/ca-certificates.crt /distroless/etc/ssl/certs/ca-certificates.crt
rm -rf /tmp/* /var/lib/apt/lists/* /var/tmp/*
EOF

# Create user and group in base stage (Debian)
RUN <<EOF
set -e
groupadd -g 1001 nodejs
useradd -u 1001 -g nodejs -s /bin/sh -m nextjs
EOF

## Preparation stage to set up /app with correct permissions
FROM node:${NODEJS_VERSION}-slim AS builder

WORKDIR /app

# Copy user info from base
COPY --from=base /etc/passwd /etc/passwd
COPY --from=base /etc/group /etc/group

# Copy artifacts from build context
COPY .next/standalone /app/
COPY node_modules/.pnpm /app/node_modules/.pnpm
COPY node_modules/pg /app/node_modules/pg
COPY node_modules/drizzle-orm /app/node_modules/drizzle-orm
COPY packages/database/migrations /app/migrations
COPY scripts/migrateServerDB/docker.cjs /app/docker.cjs
COPY scripts/migrateServerDB/errorHint.js /app/errorHint.js
COPY scripts/serverLauncher/startServer.js /app/startServer.js

# Set ownership in Debian environment which is more robust
RUN chown -R 1001:1001 /app

## Application image assembly
FROM busybox:latest AS app

# Copy distroless base from base stage
COPY --from=base /distroless/ /

# Copy the entire /app directory from builder, PRESERVING permissions
COPY --from=builder --chown=1001:1001 /app /app

# Copy user info for the final image
COPY --from=base /etc/passwd /etc/passwd
COPY --from=base /etc/group /etc/group

# Ensure proxychains config ownership
RUN [ -f /etc/proxychains4.conf ] && chown 1001:1001 /etc/proxychains4.conf || true

## Final production image
FROM scratch

COPY --from=app / /

ENV NODE_ENV="production" \
    NODE_OPTIONS="--dns-result-order=ipv4first --use-openssl-ca" \
    NODE_EXTRA_CA_CERTS="" \
    NODE_TLS_REJECT_UNAUTHORIZED="" \
    SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt" \
    MIDDLEWARE_REWRITE_THROUGH_LOCAL="1" \
    HOSTNAME="0.0.0.0" \
    PORT="3210"

# User and group IDs
USER 1001

EXPOSE 3210/tcp

ENTRYPOINT ["/bin/node"]

CMD ["/app/startServer.js"]
