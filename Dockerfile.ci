## Set global build ENV
ARG NODEJS_VERSION="24"

## --- Base Phase: Prepare Binaries ---
FROM node:${NODEJS_VERSION}-slim AS base
ARG USE_CN_MIRROR
ENV DEBIAN_FRONTEND="noninteractive"
RUN <<EOF
set -e
if [ "${USE_CN_MIRROR:-false}" = "true" ]; then
    sed -i "s/deb.debian.org/mirrors.ustc.edu.cn/g" "/etc/apt/sources.list.d/debian.sources"
fi
apt update && apt install ca-certificates proxychains-ng -qy
mkdir -p /distroless/bin /distroless/etc /distroless/etc/ssl/certs /distroless/lib
cp /usr/lib/$(arch)-linux-gnu/libproxychains.so.4 /distroless/lib/libproxychains.so.4
cp /usr/lib/$(arch)-linux-gnu/libdl.so.2 /distroless/lib/libdl.so.2
cp /usr/bin/proxychains4 /distroless/bin/proxychains
cp /etc/proxychains4.conf /distroless/etc/proxychains4.conf
cp /usr/lib/$(arch)-linux-gnu/libstdc++.so.6 /distroless/lib/libstdc++.so.6
cp /usr/lib/$(arch)-linux-gnu/libgcc_s.so.1 /distroless/lib/libgcc_s.so.1
cp /usr/local/bin/node /distroless/bin/node
cp /etc/ssl/certs/ca-certificates.crt /distroless/etc/ssl/certs/ca-certificates.crt
EOF

# Create user info
RUN <<EOF
set -e
groupadd -g 1001 nodejs
useradd -u 1001 -g nodejs -s /bin/sh -m nextjs
EOF

## --- Final Assembly Stage (BusyBox) ---
FROM busybox:latest AS app
WORKDIR /app

# Copy binaries/libraries from base
COPY --from=base /distroless/ /

# Precisely copy only what's needed for the runtime
# 1. Standalone Server
COPY --chown=1001:1001 .next/standalone /app/

# 2. Static Assets (REQUIRED for standalone)
COPY --chown=1001:1001 public /app/public
COPY --chown=1001:1001 .next/static /app/.next/static

# 3. Real Node Modules (Already dereferenced and architected in CI)
COPY --chown=1001:1001 node_modules /app/node_modules

# 4. Migrations and Scripts
COPY --chown=1001:1001 packages/database/migrations /app/migrations
COPY --chown=1001:1001 scripts/migrateServerDB/docker.cjs /app/docker.cjs
COPY --chown=1001:1001 scripts/migrateServerDB/errorHint.js /app/errorHint.js
COPY --chown=1001:1001 scripts/serverLauncher/startServer.js /app/startServer.js

# Copy user info
COPY --from=base /etc/passwd /etc/passwd
COPY --from=base /etc/group /etc/group
RUN [ -f /etc/proxychains4.conf ] && chown 1001:1001 /etc/proxychains4.conf || true

## --- Final Scratch-based production image ---
FROM scratch

# ONLY COPY what we assembled in the app stage
COPY --from=app /app /app
COPY --from=app /bin /bin
COPY --from=app /lib /lib
COPY --from=app /etc /etc
COPY --from=app /usr /usr

ENV NODE_ENV="production" \
    NODE_OPTIONS="--dns-result-order=ipv4first --use-openssl-ca" \
    SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt" \
    MIDDLEWARE_REWRITE_THROUGH_LOCAL="1" \
    HOSTNAME="0.0.0.0" \
    PORT="3210"

USER 1001
EXPOSE 3210/tcp
ENTRYPOINT ["/bin/node"]
CMD ["/app/startServer.js"]
